# URL pública definitiva, sin / al final. Se usa para canonical, OG y sitemap.
NEXT_PUBLIC_SITE_URL=https://adi-data.vercel.app
# Endpoint privado que recibe el JSON del formulario. Sin él se devuelve 503, nunca éxito.
CONTACT_WEBHOOK_URL=
# Opcional: calendario público de ADI.
NEXT_PUBLIC_ADI_CALENDAR_URL=
# Opcional: activa el asistente existente cuando su contenido esté alineado con el nuevo sitio.
NEXT_PUBLIC_ELEVENLABS_AGENT_ID=
